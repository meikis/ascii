---
/*
 * Image to ascii: an image in, SVG, PNG, JPG, WebP, GIF or any other the
 * browser reads, and an animated ascii logo out. The page draws it in the
 * browser by the method the library's logos were drawn by (lib/logo.ts), plays
 * it with the library's own mount, and writes it out as a piece file, an embed
 * snippet and README SVGs (lib/logo-file.ts). Nothing is uploaded.
 */
import Layout from "../layouts/Layout.astro";
import { glyphShapes } from "../lib/glyphs";
import { REPO } from "../lib/library";
import { LIMIT } from "../lib/logo";
import { PAGES, pageCardOf } from "../lib/pages";

// The characters' shapes, worked out here at build time; the drawing itself runs in the browser.
const glyphs = await glyphShapes();
---

<Layout title={`${PAGES.make.title} · ascii.rest`} description={PAGES.make.description} path={PAGES.make.path} card={pageCardOf("make")}>
  <h1 slot="heading">image to ascii</h1>

  <p class="lede">
    Drop in an image, an SVG, PNG, JPG, WebP or GIF, and get it back as animated ascii in its own colours. A logo is drawn the way the library's
    logos are, each cell the character whose shape best matches its edge there; a photo is shaded, each cell as dense as the image is bright
    there. A plain background is left out.
  </p>
  <p class="lede muted">It all happens in your browser. The file is never uploaded, and nothing is sent anywhere.</p>

  <section class="block maker" style="margin-top: 2rem" data-glyphs={JSON.stringify(glyphs)}>
    <div class="well big drop empty" id="drop" role="button" tabindex="0" aria-label="Choose an image, or drop one here">
      <div class="prompt" id="prompt">
<p>drop an image or video here</p>
<p class="muted">svg, png, jpg, webp, gif or mp4</p>
        <p class="muted">
          or <span class="button pick"><span>[pick a file]</span></span> or paste one
        </p>
      </div>
    </div>
    <input type="file" id="file" accept="image/*,.svg,video/mp4,video/webm" hidden />
    <p class="facts" id="facts" hidden>
      <span id="size"></span>
      <span id="colours"></span>
      <span id="moves"></span>
      <span id="bytes"></span>
      <button class="button" type="button" id="ink"><span>[mono]</span></button>
      <button class="button" type="button" id="ground" hidden><span>[keep the background]</span></button>
      <button class="button" type="button" id="again"><span>[another image]</span></button>
    </p>
    <p class="status" id="status" role="status" aria-live="polite"></p>
  </section>

  <section class="block">
    <div class="head">
      <h2>settings</h2>
    </div>
    <div class="controls">
      <label for="name">name</label>
      <span><input id="name" type="text" maxlength="32" autocomplete="off" spellcheck="false" value="my logo" /></span>

      <label for="width">width</label>
      <span><input id="width" type="number" min="16" max={LIMIT.cols} step="1" value="160" inputmode="numeric" /> columns, at most {LIMIT.cols}</span>

      <span class="label" id="style-label">style</span>
      <span class="choice" role="group" aria-labelledby="style-label">
        <button class="button" type="button" data-style="logo" aria-pressed="true"><span>logo</span></button>
        <button class="button" type="button" data-style="shade" aria-pressed="false"><span>shade</span></button>
      </span>

      <span class="label" id="motion-label">motion</span>
      <span class="choice" role="group" aria-labelledby="motion-label">
        <button class="button" type="button" data-motion="glint" aria-pressed="true"><span>glint</span></button>
        <button class="button" type="button" data-motion="scan" aria-pressed="false"><span>scan</span></button>
        <span>every <input id="every" type="number" min="3" max="60" step="1" value="5" inputmode="numeric" aria-label="seconds between passes" /> s</span>
      </span>

      <span class="label" id="category-label">category</span>
      <span class="choice" role="group" aria-labelledby="category-label">
        <button class="button" type="button" data-category="companies" aria-pressed="true"><span>companies</span></button>
        <button class="button" type="button" data-category="logos" aria-pressed="false"><span>logos</span></button>
        <button class="button" type="button" data-category="distros" aria-pressed="false"><span>distros</span></button>
      </span>
    </div>
    <p class="muted note">
      Logo draws each edge with the character that matches its shape, as the library's logos are drawn. Shade picks each character by how bright
      the image is there, from <code>.</code> to <code>@</code>, which suits a photo; an image with no plain background starts in shade.
    </p>
    <p class="muted note">
      A company or a language glints, as the library's logos do; a distro has a scan line run down it. The width is the most columns it may take;
      a tall logo takes fewer, since a piece is at most {LIMIT.rows} rows. for a photo, try a width of 200 or more.
    </p>
  </section>


  <div class="gif-overlay" id="gif-overlay" hidden>
    <div class="gif-modal">
      <div class="gif-modal-head">
        <h2>select gif frames</h2>
        <button class="button" type="button" id="gif-cancel"><span>[cancel]</span></button>
      </div>
      <p class="muted note">
        This animated GIF has <span id="frame-count">0</span> frames. Drag the sliders or click a thumbnail to choose a range.
      </p>
      <div class="frame-preview-wrap">
        <canvas id="frame-preview" width="0" height="0"></canvas>
        <span class="frame-preview-label" id="frame-preview-label">frame 0</span>
      </div>
      <div class="frames-bar-wrap">
        <div class="frames-bar" id="frames-bar"></div>
      </div>
      <div class="frame-controls">
        <div class="frame-slider-group">
          <label for="frame-start">start</label>
          <input id="frame-start" type="range" min="0" value="0" />
          <span id="frame-start-val" class="frame-val start-val">0</span>
        </div>
        <div class="frame-slider-group">
          <label for="frame-end">end</label>
          <input id="frame-end" type="range" min="0" value="0" />
          <span id="frame-end-val" class="frame-val end-val">0</span>
        </div>
      </div>
      <div class="frame-summary">
        <span id="frame-summary">0 frames selected</span>
      </div>
      <div class="gif-modal-actions">
        <button class="button primary" type="button" id="gif-confirm"><span>[make ascii gif]</span></button>
      </div>
    </div>
  </div>

  <section class="block">
    <div class="head">
      <h2><label for="paste">or paste an svg's markup</label></h2>
      <span class="tools">
        <button class="button" type="button" id="paste-go"><span>[draw it]</span></button>
      </span>
    </div>
    <textarea id="paste" rows="5" spellcheck="false" autocomplete="off" placeholder='<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">...</svg>'></textarea>
  </section>

  <div id="out" hidden>
    <section class="block">
      <div class="head">
        <h2>embed it</h2>
        <span class="tools">
          <button class="button" type="button" data-copy="embed-code" hidden><span>[copy]</span></button>
        </span>
      </div>
      <pre class="code out" id="embed-code"></pre>
      <p class="muted note">
        For any page, with no install and no build step: it loads mount.js from ascii.rest and plays the logo inlined in it, in colour on a canvas,
        or in one ink in a pre while this page shows one ink. It reads the page's text colour to tell a light page from a dark one, and holds still for
        anyone who prefers reduced motion.
      </p>
    </section>

    <section class="block">
      <div class="head">
        <h2>readme</h2>
        <span class="tools">
          <button class="button" type="button" id="svg-light"><span>[light svg]</span></button>
          <button class="button" type="button" id="svg-dark"><span>[dark svg]</span></button>
          <button class="button" type="button" data-copy="readme-code" hidden><span>[copy]</span></button>
        </span>
      </div>
      <pre class="code" id="readme-code"></pre>
      <p class="muted note">
        Two animated SVGs, one loop of the glint or the scan, which play in a GitHub README with no script. Put them beside the README; GitHub shows the
        dark one in its dark theme.
      </p>
    </section>

    <section class="block">
      <div class="head">
        <h2 id="file-name">logo.ts</h2>
        <span class="tools">
          <button class="button" type="button" data-copy="source-code" hidden><span>[copy]</span></button>
          <button class="button" type="button" id="download"><span>[download]</span></button>
          <button class="button" type="button" id="download-gif" hidden><span>[download gif]</span></button>
        </span>
      </div>
      <pre class="code out" id="source-code"></pre>
      <p class="muted note">
        A piece in the library's own format. To add it, put it in src/pieces/, run npm run gen and npm run check, and open a pull request, as
        <a href={`${REPO}/blob/main/CONTRIBUTING.md`}>CONTRIBUTING.md</a> says.
      </p>
    </section>
  </div>
</Layout>

<style>
  .prompt {
    text-align: center;
  }

  .drop.over {
    outline: 1px dotted var(--ink);
    outline-offset: -0.75rem;
  }

  /* Empty, the well is a button that opens the file picker; once the art shows it is only the art. */
  .drop.empty {
    cursor: pointer;
  }

  .drop.empty:focus-visible {
    outline: 1px dotted var(--ink);
    outline-offset: 2px;
  }

  .status:empty {
    display: none;
  }

  .status {
    margin-top: 0.75rem;
    color: var(--ink);
  }

  .facts + .status {
    margin-top: 0.25rem;
  }

  .facts {
    margin-top: 0.75rem;
  }

  /* site.css gives .facts its display after [hidden], so hidden needs saying again. */
  .facts[hidden] {
    display: none;
  }

  .controls {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    align-items: baseline;
    gap: 0.75rem 3ch;
  }

  .controls > label,
  .controls > .label {
    color: var(--muted);
  }

  .choice {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 2ch;
  }

  /* The choice in force wears its brackets, as a usage tab does; the others keep the room for them. */
  .choice [aria-pressed] > span::before {
    content: "[";
    visibility: hidden;
  }

  .choice [aria-pressed] > span::after {
    content: "]";
    visibility: hidden;
  }

  .choice [aria-pressed="true"] {
    color: var(--ink);
  }

  .choice [aria-pressed="true"] > span::before,
  .choice [aria-pressed="true"] > span::after {
    visibility: visible;
  }

  input,
  textarea {
    margin: 0;
    padding: 0 1ch;
    border: 0;
    border-radius: 0;
    background: var(--well);
    color: var(--ink);
    font: inherit;
  }

  #name {
    width: min(100%, 34ch);
  }

  input[type="number"] {
    width: 6ch;
    -moz-appearance: textfield;
    appearance: textfield;
  }

  input[type="number"]::-webkit-inner-spin-button,
  input[type="number"]::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  textarea {
    display: block;
    width: 100%;
    min-height: 8rem;
    padding: 1rem 2ch;
    color: var(--text);
    font-size: 0.8125rem;
    line-height: 1.6;
    resize: vertical;
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: 1px dotted var(--ink);
    outline-offset: 2px;
  }

  ::placeholder {
    color: var(--muted);
    opacity: 1;
  }

  .note {
    max-width: 72ch;
    margin-top: 0.75rem;
  }

  .note a {
    text-decoration-line: underline;
    text-decoration-style: dotted;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--muted);
    text-underline-offset: 0.25em;
  }

  .head h2 label {
    cursor: inherit;
  }

  pre.out {
    max-height: 26rem;
    overflow: auto;
  }

  #out {
    margin-top: 2.5rem;
  }

  /* --- GIF frame selection modal --- */
  .gif-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000; padding: 2rem; }
  .gif-overlay[hidden] { display: none; }
  .gif-modal { background: var(--well); border: 1px solid var(--ink); border-radius: 0.5rem; padding: 1.5rem; max-width: 900px; width: 100%; max-height: 90vh; overflow-y: auto; }
  .gif-modal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem; }
  .gif-modal-head h2 { margin: 0; }
  .gif-modal-actions { margin-top: 1rem; text-align: right; }
  .gif-modal-actions .button.primary { font-weight: bold; }
  .frame-summary { margin-top: 0.5rem; color: var(--muted); font-size: 0.875rem; }
  .frame-preview-wrap { display: flex; flex-direction: column; align-items: center; margin-bottom: 0.5rem; }
  .frame-preview-wrap canvas { max-height: 120px; max-width: 100%; border: 1px solid var(--ink); border-radius: 0.25rem; }
  .frame-preview-label { margin-top: 0.25rem; font-size: 0.8rem; color: var(--muted); }
  .frames-bar-wrap { overflow-x: auto; overflow-y: hidden; padding: 0.25rem 0; }
  .frames-bar { display: flex; gap: 2px; padding: 0.25rem 0; }
  .frames-bar canvas { height: 48px; border: 2px solid transparent; cursor: pointer; flex-shrink: 0; border-radius: 2px; }
  .frames-bar canvas.frame-start { border-color: #4ade80; box-shadow: 0 0 4px #4ade80; }
  .frames-bar canvas.frame-end { border-color: #fb923c; box-shadow: 0 0 4px #fb923c; }
  .frames-bar canvas.selected { filter: brightness(1.15); }
  .frames-bar canvas:not(.selected) { opacity: 0.4; }
  .frame-controls { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 0.75rem; }
  .frame-slider-group { display: flex; align-items: center; gap: 0.5rem 1ch; }
  .frame-slider-group label { color: var(--muted); min-width: 3rem; }
  .frame-slider-group input[type="range"] { flex: 1; min-width: 8rem; }
  .frame-val { min-width: 4ch; text-align: right; font-weight: bold; }
  .start-val { color: #4ade80; }
  .end-val { color: #fb923c; }

</style>

<script>
  import { mount, names, type Piece } from "ascii.rest";
  import { draw, isSvg, LIMIT, raster, render, palette as paletteFn, type Drawing, type Glyph, type RGB, type Source, type Style } from "../lib/logo";
  import { about, clean, embed, picture, piece, source, type Kind, type Settings } from "../lib/logo-file";
  import { paint } from "../lib/paint";
  import { svgOf } from "../lib/svg";
import { gifFrames, type GifFrame } from "../lib/gif-frames";
import { gif as makeGif, type Look } from "../lib/download";
import { videoFrames, type VideoFrameData } from "../lib/video-frames";

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const glyphs = JSON.parse(document.querySelector<HTMLElement>(".maker")!.dataset.glyphs!) as Glyph[];

  const drop = $("drop"), prompt = $("prompt"), picker = $<HTMLInputElement>("file"), status = $("status");
  const nameInput = $<HTMLInputElement>("name"), widthInput = $<HTMLInputElement>("width"), everyInput = $<HTMLInputElement>("every");
  const paste = $<HTMLTextAreaElement>("paste"), inkButton = $<HTMLButtonElement>("ink"), groundButton = $<HTMLButtonElement>("ground");

  let src: Source | null = null;
  // The last image that isn't an SVG, kept so its background can be put back, or taken out again.
  let image: Blob | null = null;
  let keepGround = false;
  let style: Style = "logo";
  let drawing: Drawing | null = null;
  let file = "";
  let named = false; // the reader typed the name, so a new file keeps it
  let category: Kind = "companies";
let made: { piece: Piece; slug: string; ts: string } | null = null;
let gifAnimation: GifFrame[] | null = null;
let frameSources: Source[] | null = null;
let gifPreviewOnly = false;
// Cached drawn frames from the last buildGifPiece, so mono/colour toggle can re-mount without re-drawing.
let cachedFrames: { drawings: Drawing[]; lo: number; hi: number; width: number; style: Style; s: Settings } | null = null;
let stop = () => {};
  // Logos come in colour or in one ink, and the choice holds from page to page, as on the rest of the site.
  let mono = false;
  try {
    mono = localStorage.getItem("ascii-ink") === "mono";
  } catch {}
  const motion = () => {
    try {
      return localStorage.getItem("ascii-motion") === "play";
    } catch {
      return false;
    }
  };

  const say = (text: string) => (status.textContent = text);
  const later = (fn: () => void, ms: number) => {
    let timer = 0;
    return () => {
      clearTimeout(timer);
      timer = window.setTimeout(fn, ms);
    };
  };

// Shows a centered progress overlay with a label and optional progress bar.
function showProgress(text: string, pct = -1) {
  const wrap = document.createElement("div");
  wrap.style.cssText = "position:fixed;inset:0;background:rgba(0,0,0,0.4);display:flex;align-items:center;justify-content:center;z-index:2000;padding:2rem;";
  const inner = document.createElement("div");
  inner.style.cssText = "background:var(--well);border:1px solid var(--ink);border-radius:0.5rem;padding:1.5rem 2rem;min-width:300px;text-align:center;";
  const label = document.createElement("p");
  label.style.cssText = "margin:0 0 0.75rem;";
  label.textContent = text;
  const bar = document.createElement("div");
  bar.style.cssText = `height:6px;background:var(--muted);border-radius:3px;overflow:hidden;display:${pct >= 0 ? "block" : "none"};`;
  const fill = document.createElement("div");
  fill.style.cssText = "height:100%;width:0%;background:var(--ink);transition:width 0.1s;";
  bar.append(fill);
  inner.append(label, bar);
  wrap.append(inner);
  document.body.append(wrap);
  return {
    update(t: string, p = -1) { label.textContent = t; if (p >= 0) { bar.style.display = "block"; fill.style.width = `${p}%`; } },
    remove() { wrap.remove(); },
  };
}
  const width = () => Math.max(16, Math.min(LIMIT.cols, Math.round(+widthInput.value) || 160));
  const settings = (): Settings => ({ proper: nameInput.value, file, category, every: +everyInput.value || 5 });

  // Wraps the synchronous, CPU-heavy draw() in a setTimeout(0) so the browser can
  // repaint (and not show a "page not responding" dialog) before the work runs.
  function drawAsync(src: Source, w: number, glyphs: Glyph[], style: Style): Promise<Drawing> {
    return new Promise<Drawing>((resolve) => {
      setTimeout(() => resolve(draw(src, w, glyphs, style)), 0);
    });
  }

  // An image's name without its extension, as the piece's name, unless the reader typed one.
  const nameFrom = (from: string) => {
    const ext = /\.(svg|png|jpe?g|webp|gif|avif|bmp|ico|tiff?)$/i;
    if (!named && ext.test(from)) nameInput.value = clean(from.replace(ext, "").replace(/[-_]+/g, " ")) || "my logo";
  };

  // Each image taken gets the next number; a read that finishes after a newer one began is dropped, so the last image
  // chosen is the one shown, however long each takes to decode.
  let reading = 0;

  async function take(markup: string, from: string, mine = ++reading) {
    say("drawing it");
    let next: Source;
    try {
      next = await render(markup);
    } catch (error) {
      if (mine === reading) say((error as Error).message);
      return;
    }
    if (mine !== reading) return;
    src = next;
    image = null;
    file = from;
    nameFrom(from);
    groundButton.hidden = true;
    pickStyle("logo");
  }

  // Any other image: drawn, its plain background left out unless the reader keeps it.
  async function takeImage(blob: Blob, from: string, mine = ++reading) {
    console.log(`[make] takeImage: name=${from}, blob.type=${blob.type}, size=${blob.size}`);
    say("drawing it");
    // Check if this is an animated GIF with multiple frames.
    const isGif = blob.type === "image/gif" || (typeof (blob as File).name === "string" && /\.gif$/i.test((blob as File).name));
    if (isGif) {
      console.log("[make] detected GIF, parsing frames...");
      try {
        const frames = await gifFrames(blob);
        console.log(`[make] gifFrames returned ${frames.length} frames`);
        if (frames.length > 1 && mine === reading) {
          console.log(`[make] entering GIF animation mode with ${frames.length} frames`);
          gifAnimation = frames;
          gifPreviewOnly = true;
          frameSources = [];
          for (const frame of frames) {
            frameSources.push(sourceFromImageData(frame.data));
          }
          src = frameSources[0];
          image = blob;
          file = from;
          nameFrom(from);
          style = "shade";
          for (const b of styles) b.setAttribute("aria-pressed", String(b.dataset.style === "shade"));
          groundButton.hidden = true;
          setGifMode(true);
          showFrames(frames);
          say(`GIF with ${frames.length} frames. Select a range in the dialog, then click [make ascii gif].`);
          return;
        } else {
          console.log(`[make] not entering GIF mode: frames.length=${frames.length}, mine===reading=${mine === reading}`);
        }
      } catch (err) {
        console.warn("[make] GIF frame parsing failed:", err);
      }
    }
    // Not an animated GIF, or frame extraction failed: treat as a single image.
    gifAnimation = null;
    frameSources = null;
    gifPreviewOnly = false;
    cachedFrames = null;
    setGifMode(false);
    hideFrames();
    const prog = showProgress("processing image\u2026");
    let next: Source;
    try {
      next = await raster(blob, { keepGround });
    } catch (error) {
      prog.remove();
      if (mine === reading) say((error as Error).message);
      return;
    }
    if (mine !== reading) { prog.remove(); return; }
    src = next;
    image = blob;
    file = from;
    nameFrom(from);
    await new Promise<void>((r) => setTimeout(r, 0));
    prog.update("drawing ascii\u2026");
    await new Promise<void>((r) => setTimeout(r, 0));
    const nextStyle: Style = src.photo ? "shade" : "logo";
    style = nextStyle;
    for (const b of styles) b.setAttribute("aria-pressed", String(b.dataset.style === nextStyle));
    // draw() is CPU-heavy; yield before and after so the browser can update the progress overlay.
    drawing = await drawAsync(src, width(), glyphs, style);
    update();
    prog.remove();
    groundButton.hidden = !src.ground && !keepGround;
    groundButton.firstElementChild!.textContent = keepGround ? "[remove the background]" : "[keep the background]";
  }

  // Video: extract frames at a target fps, then show the same frame selection modal as GIF.
  async function takeVideo(blob: Blob, from: string, mine = ++reading) {
    say("loading video…");
    const prog = showProgress("loading video…");
    try {
      // Extract frames with progress updates.
      const frames: GifFrame[] = [];
      const videoData = await videoFrames(blob, 10, 200, (done, total) => {
        prog.update(`extracting frame ${done} / ${total}…`, Math.round((done / total) * 100));
      }, (stage) => {
        prog.update(stage);
      });
      // Convert VideoFrameData to GifFrame format for reuse of the GIF UI.
      for (const v of videoData) {
        frames.push({ data: v.data, delay: v.delay });
      }
      prog.remove();
      if (frames.length > 1 && mine === reading) {
        console.log(`[make] video extracted ${frames.length} frames`);
        gifAnimation = frames;
        gifPreviewOnly = true;
        frameSources = [];
        for (const frame of frames) {
          frameSources.push(sourceFromImageData(frame.data));
        }
        src = frameSources[0];
        image = blob;
        file = from;
        nameFrom(from);
        style = "shade";
        for (const b of styles) b.setAttribute("aria-pressed", String(b.dataset.style === "shade"));
        groundButton.hidden = true;
        setGifMode(true);
        showFrames(frames);
        say(`Video with ${frames.length} frames. Select a range in the dialog, then click [make ascii gif].`);
        return;
      } else {
        console.log(`[make] video: not enough frames (${frames.length})`);
        say("video too short to make an animation");
      }
    } catch (err) {
      prog.remove();
      const errMsg = err instanceof Error ? err.message : typeof err === "string" ? err : JSON.stringify(err);
      console.warn("[make] video frame extraction failed:", err, "| errMsg:", errMsg);
      if (mine === reading) say(`video error: ${errMsg}`);
    }
    // Do NOT fall back to takeImage — a video is not an image, and
    // takeImage would fail again with "not an image".
    gifAnimation = null;
    frameSources = null;
    gifPreviewOnly = false;
    cachedFrames = null;
    setGifMode(false);
    hideFrames();
  }

// GIF mode: hides motion and category, which don't apply to GIF frame animations.
function setGifMode(on: boolean) {
  const motionLabel = $<HTMLElement>("motion-label");
  const categoryLabel = $<HTMLElement>("category-label");
  // The label and its following .choice span form a row in the grid; hide both.
  const hide = (label: HTMLElement | null) => {
    if (!label) return;
    label.style.display = "none";
    const next = label.nextElementSibling as HTMLElement | null;
    if (next) next.style.display = "none";
  };
  const show = (label: HTMLElement | null) => {
    if (!label) return;
    label.style.display = "";
    const next = label.nextElementSibling as HTMLElement | null;
    if (next) next.style.display = "";
  };
  if (on) { hide(motionLabel); hide(categoryLabel); }
  else { show(motionLabel); show(categoryLabel); }
}

  // Builds a Source from an ImageData (a GIF frame).
  function sourceFromImageData(img: ImageData): Source {
    const W = img.width, H = img.height;
    const canvas = document.createElement("canvas");
    canvas.width = W;
    canvas.height = H;
    const ctx = canvas.getContext("2d", { willReadFrequently: true })!;
    ctx.putImageData(img, 0, 0);
    const data = img.data;
    let x0 = W, y0 = H, x1 = -1, y1 = -1;
    for (let y = 0; y < H; y++) {
      const rowBase = y * W;
      for (let x = 0; x < W; x++)
        if (data[(rowBase + x) * 4 + 3] > 1) {
          if (x < x0) x0 = x;
          if (x > x1) x1 = x;
          if (y < y0) y0 = y;
          y1 = y;
        }
    }
    if (x1 < 0) return { canvas, x: 0, y: 0, w: W, h: H, photo: true };
    return { canvas, x: x0, y: y0, w: x1 - x0 + 1, h: y1 - y0 + 1, photo: true };
  }

  // Shows the GIF frame selection modal with thumbnails and range sliders.
  function showFrames(frames: GifFrame[]) {
    const overlay = $("gif-overlay");
    const bar = $<HTMLDivElement>("frames-bar");
    const startSlider = $<HTMLInputElement>("frame-start");
    const endSlider = $<HTMLInputElement>("frame-end");
    const countLabel = $<HTMLSpanElement>("frame-count");
    bar.innerHTML = "";
    const max = frames.length - 1;
    startSlider.max = String(max);
    endSlider.max = String(max);
    startSlider.value = "0";
    endSlider.value = String(max);
    countLabel.textContent = String(frames.length);
    const thumbCount = Math.min(frames.length, 200);
    for (let i = 0; i < thumbCount; i++) {
      const c = document.createElement("canvas");
      const scale = 48 / frames[i].data.height;
      c.width = Math.round(frames[i].data.width * scale);
      c.height = 48;
      const ctx = c.getContext("2d")!;
      const tmp = document.createElement("canvas");
      tmp.width = frames[i].data.width;
      tmp.height = frames[i].data.height;
      tmp.getContext("2d")!.putImageData(frames[i].data, 0, 0);
      ctx.drawImage(tmp, 0, 0, c.width, c.height);
      c.title = `frame ${i}`;
      c.dataset.frame = String(i);
      c.addEventListener("click", (ev) => {
        if (ev.shiftKey) {
          endSlider.value = String(i);
        } else {
          startSlider.value = String(i);
          if (+endSlider.value < i) endSlider.value = String(i);
        }
        updateFrameSelection();
      });
      bar.append(c);
    }
    overlay.hidden = false;
    updateFrameSelection();
  }

  function hideFrames() { $("gif-overlay").hidden = true; }

  // Highlights selected thumbnails, updates the large preview, and scrolls the strip.
  function updateFrameSelection() {
    if (!gifAnimation) return;
    const startVal = +$<HTMLInputElement>("frame-start").value;
    const endVal = +$<HTMLInputElement>("frame-end").value;
    const lo = Math.min(startVal, endVal), hi = Math.max(startVal, endVal);
    $<HTMLSpanElement>("frame-start-val").textContent = String(lo);
    $<HTMLSpanElement>("frame-end-val").textContent = String(hi);
    const canvases = document.querySelectorAll<HTMLCanvasElement>("#frames-bar canvas");
    canvases.forEach((c, i) => {
      c.classList.toggle("selected", i >= lo && i <= hi);
      c.classList.toggle("frame-start", i === lo);
      c.classList.toggle("frame-end", i === hi);
    });
    const activeIdx = document.activeElement === $("frame-end") ? hi : lo;
    const activeCanvas = canvases[activeIdx] as HTMLCanvasElement | undefined;
    if (activeCanvas) {
      const wrap = activeCanvas.parentElement!.parentElement!;
      const cRect = activeCanvas.getBoundingClientRect();
      const wRect = wrap.getBoundingClientRect();
      if (cRect.left < wRect.left || cRect.right > wRect.right) {
        wrap.scrollTo({ left: activeCanvas.offsetLeft - wrap.clientWidth / 2 + activeCanvas.offsetWidth / 2, behavior: "smooth" });
      }
    }
    const previewIdx = document.activeElement === $("frame-end") ? hi : lo;
    const previewCanvas = $<HTMLCanvasElement>("frame-preview");
    const labelEl = $<HTMLSpanElement>("frame-preview-label");
    if (gifAnimation[previewIdx]) {
      const frame = gifAnimation[previewIdx].data;
      const maxH = 120;
      const scale = Math.min(1, maxH / frame.height);
      previewCanvas.width = frame.width;
      previewCanvas.height = frame.height;
      previewCanvas.style.width = `${Math.round(frame.width * scale)}px`;
      previewCanvas.style.height = `${Math.round(frame.height * scale)}px`;
      previewCanvas.getContext("2d")!.putImageData(frame, 0, 0);
      const which = document.activeElement === $("frame-end") ? "end" : "start";
      labelEl.textContent = `frame ${previewIdx} (${which})`;
    }
    const count = hi - lo + 1;
    $<HTMLSpanElement>("frame-summary").textContent = `${count} frame${count === 1 ? "" : "s"} selected (frame ${lo} to ${hi})`;
  }

function redraw() {
if (!src) return;
// In GIF mode, skip single-frame draw; update() will call buildGifPiece.
if (gifAnimation && frameSources && !gifPreviewOnly) {
update();
return;
}
// draw() is CPU-heavy; run it asynchronously to avoid blocking the UI.
void (async () => {
drawing = await drawAsync(src, width(), glyphs, style);
update();
})();
}

  const styles = [...document.querySelectorAll<HTMLButtonElement>("[data-style]")];
  function pickStyle(next: Style) {
    style = next;
    for (const b of styles) b.setAttribute("aria-pressed", String(b.dataset.style === next));
    redraw();
  }
  for (const b of styles) b.addEventListener("click", () => pickStyle(b.dataset.style as Style));

  function update() {
    // GIF mode: check if we can just re-mount (mono toggle) or need to re-build frames.
    if (gifAnimation && frameSources && !gifPreviewOnly) {
      const start = +$<HTMLInputElement>("frame-start").value;
      const end = +$<HTMLInputElement>("frame-end").value;
      const lo = Math.min(start, end), hi = Math.max(start, end);
      // If we have cached frames for this exact range, width and style, just re-mount with current mono.
      if (cachedFrames && cachedFrames.lo === lo && cachedFrames.hi === hi && cachedFrames.width === width() && cachedFrames.style === style) {
        // Re-create the piece from cached drawings (so embed/readme code reflects current mono), then play.
        const s = settings();
        drawing = cachedFrames.drawings[0];
        made = makeAnimatedPiece(cachedFrames.drawings, gifAnimation, lo, s);
        play();
        const n = drawing.colors.length;
        $("colours").textContent = n === 1 ? "1 colour" : `${n} colours`;
        $("embed-code").textContent = "(multi-frame GIF piece \u2014 use the .ts file)";
        $("readme-code").textContent = "(multi-frame GIF piece \u2014 use the .ts file)";
        $("download-gif").hidden = false;
        return;
      }
      // Frame range or width changed: re-build from scratch.
      void buildGifPiece();
      return;
    }
    if (!drawing) return;
    const s = settings();
    const { slug, every, scan } = about(drawing, s);
    const ts = source(drawing, s);
    made = { piece: piece(drawing, s), slug, ts };
    // Hide the [download gif] button for single-frame images.
    $("download-gif").hidden = true;
    play();
    const n = drawing.colors.length;
    $("size").textContent = `${drawing.cols}×${drawing.rows}`;
    $("colours").textContent = n === 1 ? "1 colour" : `${n} colours`;
    $("moves").textContent = scan ? `a scan every ${every} s` : `a glint every ${every} s`;
    const bytes = new TextEncoder().encode(ts).length;
    $("bytes").textContent = `${(bytes / 1024).toFixed(1)} kB`;
    $("file-name").textContent = `${slug}.ts`;
    paint($("source-code"), ts, "ts");
    paint($("embed-code"), embed(drawing, s, mono), "html");
    paint($("readme-code"), picture(drawing, s), "html");
    prompt.hidden = true;
    // The art is showing: the well stops being a button, and [another image] is the way to start again.
    drop.classList.remove("empty");
    for (const a of ["role", "tabindex", "aria-label"]) drop.removeAttribute(a);
    $("facts").hidden = false;
    $("out").hidden = false;
    // A taken name matters most, since the piece can't be added under it; then the background left out, if any.
    if ((names as string[]).includes(slug)) say(`the library already has a piece called ${slug}: give this one another name to add it`);
    else say(src?.ground ? `left out its background, ${src.ground}` : "");
  }

  // Async GIF piece builder: processes frames in batches with progress.
  async function buildGifPiece() {
    if (!gifAnimation || !frameSources) return;
    const start = +$<HTMLInputElement>("frame-start").value;
    const end = +$<HTMLInputElement>("frame-end").value;
    const lo = Math.min(start, end), hi = Math.max(start, end);
    const total = hi - lo + 1;
    if (total <= 0) return;

    const prog = showProgress(`processing frame 0 / ${total}\u2026`, 0);
    await new Promise<void>((r) => setTimeout(r, 0));

    const w = width();
    const s = settings();
    const selectedFrames: Drawing[] = [];
    const BATCH = 8;
    for (let i = lo; i <= hi; i++) {
      if (!frameSources[i]) continue;
      // Use drawAsync so the browser can repaint between frames.
      selectedFrames.push(await drawAsync(frameSources[i], w, glyphs, style));
      const done = selectedFrames.length;
      if (done % BATCH === 0 || done === total) {
        prog.update(`processing frame ${done} / ${total}\u2026`, Math.round((done / total) * 100));
        await new Promise<void>((r) => setTimeout(r, 0));
      }
    }
    if (selectedFrames.length === 0) { prog.remove(); return; }

    prog.update("finalizing\u2026");
    await new Promise<void>((r) => setTimeout(r, 0));

    drawing = selectedFrames[0];
    made = makeAnimatedPiece(selectedFrames, gifAnimation, lo, s);
    // Cache the drawn frames so a mono/colour toggle re-mounts instantly without re-drawing.
    cachedFrames = { drawings: selectedFrames, lo, hi, width: w, style, s };
    // The frames are now built: clear the preview-only flag so update() uses the cache on mono/colour toggle.
    gifPreviewOnly = false;
    await new Promise<void>((r) => setTimeout(r, 0));
    play();

    const n = drawing.colors.length;
    $("size").textContent = `${drawing.cols}\u00d7${drawing.rows}`;
    $("colours").textContent = n === 1 ? "1 colour" : `${n} colours`;
    $("moves").textContent = `${selectedFrames.length} frames, ${made.piece.meta.fps} fps`;
    const bytes = new TextEncoder().encode(made.ts).length;
    $("bytes").textContent = `${(bytes / 1024).toFixed(1)} kB`;
    $("file-name").textContent = `${made.slug}.ts`;
    prompt.hidden = true;
    drop.classList.remove("empty");
    for (const a of ["role", "tabindex", "aria-label"]) drop.removeAttribute(a);
    $("facts").hidden = false;
    $("out").hidden = false;
    if ((names as string[]).includes(made.slug)) say(`the library already has a piece called ${made.slug}: give this one another name to add it`);
    else say(`${selectedFrames.length} frames from frame ${lo} to ${hi}`);
    $("embed-code").textContent = "(multi-frame GIF piece \u2014 use the .ts file)";
    $("readme-code").textContent = "(multi-frame GIF piece \u2014 use the .ts file)";
    // Show the [download gif] button for animated pieces.
    $("download-gif").hidden = false;
    await new Promise<void>((r) => setTimeout(r, 0));
    paint($("source-code"), made.ts, "ts");
    prog.remove();
  }

  // Builds an animated piece from multiple drawings (one per GIF frame), and its TypeScript source.
  function makeAnimatedPiece(frames: Drawing[], gif: GifFrame[], startIdx: number, s: Settings): { piece: Piece; slug: string; ts: string } {
    const first = frames[0];
    const fps = 10;
    const totalDelay = gif.slice(startIdx, startIdx + frames.length).reduce((sum, f) => sum + f.delay, 0);
    const loop = totalDelay / 1000 || frames.length / fps;
    const slug = clean(s.proper).replace(/\s+/g, "-") || "my-logo";
    const parts_ = about(first, s);

    // Collect a unified palette across all frames: each frame's draw() quantizes colours independently,
    // so ink indices are local to each frame. We merge all frames' colours into one palette and remap.
    const unifiedColors: RGB[] = [];
    const colorKey = (c: RGB) => `${c[0]},${c[1]},${c[2]}`;
    const unifiedMap = new Map<string, number>();
    for (const f of frames) {
      for (const c of f.colors) {
        const key = colorKey(c);
        if (!unifiedMap.has(key)) {
          unifiedMap.set(key, unifiedColors.length);
          unifiedColors.push(c);
        }
      }
    }
    const colors = unifiedColors;
    const nColors = colors.length;

    // Remap each frame's ink indices from local colours to unified palette indices.
    const remappedInk: string[][] = frames.map((f) => {
      const localToUnified = f.colors.map(c => unifiedMap.get(colorKey(c))!);
      return f.ink.map(row =>
        row.replace(/[^ ]/g, ch => {
          const localIdx = ch.charCodeAt(0);
          const idx = localIdx >= 48 && localIdx <= 57 ? localIdx - 48
            : localIdx >= 97 && localIdx <= 122 ? localIdx - 87
            : 0;
          return (localToUnified[idx] ?? 0).toString(36);
        })
      );
    });

    const hexColors = colors.map(c => `#${c.map(v => Math.max(0, Math.min(255, v)).toString(16).padStart(2, "0")).join("")}`);
    // palette must be hex strings for mount's canvas rendering; use the library's palette() for proper light/dark variants.
    const fullPalette = paletteFn(colors);
    const meta = {
      name: parts_.name, category: s.category, note: `${frames.length} frames from an animation`,
      cols: first.cols, rows: first.rows, fps, loop,
      palette: nColors > 1 ? fullPalette : undefined,
    };
    const frameData = frames.map((d, i) => ({ art: d.art, ink: remappedInk[i] }));
    const ex = hexColors.length > 1 ? `const palette = [${hexColors.map(h => `0x${h.slice(1)}`).join(", ")}];\n` : "";
    const ts = `/*\n * Generated on https://ascii.rest/make/\n */\nimport type { Frame, Meta } from "../types.ts";\n\n${ex}const meta = ${JSON.stringify(meta)} as const;\n\nconst frames: { art: string[]; ink: string[] }[] = ${JSON.stringify(frameData)};\n\nconst frameFns: Frame[] = frames.map((f) => {\n  const lines = f.art.map(r => r.padEnd(first.cols));\n  const inkLines = f.ink.map(r => r.padEnd(first.cols));\n  return (t: number, env?: { paper?: boolean; color?: Uint8Array }) => {\n    const n = meta.palette ? meta.palette!.length / 6 : 1;\n    const out: string[] = [];\n    for (let y = 0; y < first.rows; y++) {\n      let line = "";\n      for (let x = 0; x < first.cols; x++) {\n        line += lines[y][x] || " ";\n      }\n      out.push(line);\n    }\n    return out.join("\\n");\n  };\n});\n\nexport default { meta, frames: frameFns } as unknown as { meta: Meta; default: Frame };\n`;
    const runtimePiece: Piece = {
      meta,
      default: () => {
        // Pre-build a Frame function for each GIF frame that fills the color array from ink data.
        const frameFns: Frame[] = frames.map((f, fi) => {
          const lines = f.art.map(r => r.padEnd(first.cols));
          const inkLines = remappedInk[fi].map(r => r.padEnd(first.cols));
          return (t: number, env?: { paper?: boolean; color?: Uint8Array }) => {
            const out: string[] = [];
            for (let y = 0; y < first.rows; y++) out.push(lines[y] || "");
            const text = out.join("\n");
            // Fill the color buffer for canvas rendering: each non-space cell gets its ink colour index.
            if (env?.color && nColors > 1) {
              let i = 0;
              for (let y = 0; y < first.rows; y++) {
                const inkRow = inkLines[y] || "";
                for (let x = 0; x < first.cols; x++) {
                  const ch = text.charCodeAt(y * (first.cols + 1) + x);
                  if (ch !== 32 && ch !== 10) {
                    const inkChar = inkRow.charCodeAt(x);
                    const inkIdx = inkChar >= 48 && inkChar <= 57 ? inkChar - 48
                      : inkChar >= 97 && inkChar <= 122 ? inkChar - 87
                      : 0;
                    env.color[i] = (env.paper ? 0 : 3 * nColors) + inkIdx;
                  }
                  i++;
                }
              }
            }
            return text;
          };
        });
        // Return a single Frame function that cycles through frames based on time.
        return (t: number, env?: { paper?: boolean; color?: Uint8Array }) => {
          const idx = Math.floor((t / loop) * frames.length) % frames.length;
          return frameFns[idx](t, env);
        };
      },
    };
    return { piece: runtimePiece, slug, ts };
  }

  // Plays the piece in the well with the library's own mount, as a canvas in colour or a <pre> in one ink.
  function play() {
    if (!made) return;
    stop();
    const { meta } = made.piece;
    const el = document.createElement(mono ? "pre" : "canvas");
    el.className = "art";
    el.setAttribute("role", "img");
    el.setAttribute("aria-label", meta.name);
    el.style.setProperty("--cols", String(meta.cols));
    el.style.setProperty("--rows", String(meta.rows));
    if (!mono) el.style.width = "var(--fit)";
    drop.querySelector(".art")?.remove();
    drop.append(el);
    stop = mount(el, made.piece, { motion: motion() });
  }

  function save(name: string, text: string | Blob, type: string) {
    const a = document.createElement("a");
    a.href = URL.createObjectURL(text instanceof Blob ? text : new Blob([text], { type }));
    a.download = name;
    document.body.append(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 4000);
  }

  async function read(f: File | undefined) {
    if (!f) return;
    const mine = ++reading;
    const svg = isSvg(f) || (!f.type && /^\s*(<\?xml[^>]*>\s*)?<svg[\s>]/i.test(await f.slice(0, 512).text()));
    if (svg) {
      if (f.size > 4_000_000) return say("that svg is over 4 MB, which is a lot for a logo");
      return take(await f.text(), f.name, mine);
    }
    // Video: MP4, WebM, MOV — extract frames and enter the frame selection modal.
    const isVideo = f.type.startsWith("video/") || /\.(mp4|webm|mov|avi|mkv)$/i.test(f.name);
    if (isVideo) {
      if (f.size > 100_000_000) return say("that video is over 100 MB: try a smaller one");
      keepGround = false;
      takeVideo(f, f.name, mine);
      return;
    }
    if (f.size > 40_000_000) return say("that image is over 40 MB: try a smaller one");
    if (f.type && !f.type.startsWith("image/")) return say("that is not an image or video: try an svg, png, jpg, webp, gif or mp4");
    keepGround = false;
    takeImage(f, f.name, mine);
  }

  // --- in ---------------------------------------------------------------------

  // The empty well is the one control that opens the picker: on a click anywhere in it, [pick a file] included, which
  // is only its words styled as a button, not a second control; and on Enter or Space while the well has focus.
  drop.addEventListener("click", () => {
    if (drop.classList.contains("empty")) picker.click();
  });
  drop.addEventListener("keydown", (e) => {
    if (e.target !== drop || !drop.classList.contains("empty") || (e.key !== "Enter" && e.key !== " ")) return;
    e.preventDefault();
    picker.click();
  });
  $("again").addEventListener("click", () => picker.click());
  picker.addEventListener("change", () => {
    read(picker.files?.[0]);
    picker.value = "";
  });
  $("paste-go").addEventListener("click", () => {
    if (paste.value.trim()) take(paste.value, "pasted markup");
  });
  // An image pasted anywhere on the page, a screenshot say; text pasted into a field stays text.
  addEventListener("paste", (e) => {
    const f = [...(e.clipboardData?.files ?? [])].find((f) => f.type.startsWith("image/"));
    if (!f) return;
    e.preventDefault();
    read(new File([f], f.name || "pasted image.png", { type: f.type }));
  });
  groundButton.addEventListener("click", () => {
    if (!image) return;
    keepGround = !keepGround;
    takeImage(image, file);
  });

  // A file can be dropped anywhere on the page; the well shows where it lands.
  let depth = 0;
  const carriesFile = (e: DragEvent) => [...(e.dataTransfer?.types ?? [])].includes("Files");
  addEventListener("dragenter", (e) => {
    if (!carriesFile(e)) return;
    depth++;
    drop.classList.add("over");
  });
  addEventListener("dragleave", (e) => {
    if (!carriesFile(e)) return;
    if (--depth <= 0) (depth = 0), drop.classList.remove("over");
  });
  addEventListener("dragover", (e) => {
    if (carriesFile(e)) e.preventDefault();
  });
  addEventListener("drop", (e) => {
    if (!carriesFile(e)) return;
    e.preventDefault();
    depth = 0;
    drop.classList.remove("over");
    read(e.dataTransfer?.files[0]);
  });

  // --- settings ---------------------------------------------------------------

  const soon = later(update, 150);
  nameInput.addEventListener("input", () => {
    named = true;
    soon();
  });
  widthInput.addEventListener("change", later(redraw, 250));
  everyInput.addEventListener("input", soon);

  // Frame range sliders: input only updates DOM, no draw/update.
  const frameStart = $<HTMLInputElement>("frame-start");
  const frameEnd = $<HTMLInputElement>("frame-end");
  frameStart.addEventListener("input", updateFrameSelection);
  frameEnd.addEventListener("input", updateFrameSelection);

  // Confirm: close modal, generate the ASCII GIF piece from selected frames.
  $("gif-confirm").addEventListener("click", () => {
    if (!gifAnimation || !frameSources) return;
    hideFrames();
    gifPreviewOnly = false;
    const start = +frameStart.value, end = +frameEnd.value;
    const lo = Math.min(start, end);
    src = frameSources[lo] ?? frameSources[0];
    drawing = null;
    update();
  });

  // Cancel: close modal, reset GIF state.
  $("gif-cancel").addEventListener("click", () => {
    hideFrames();
    gifAnimation = null;
    frameSources = null;
    gifPreviewOnly = false;
    cachedFrames = null;
    setGifMode(false);
    say("cancelled gif selection");
  });

  const motions = [...document.querySelectorAll<HTMLButtonElement>("[data-motion]")];
  const categories = [...document.querySelectorAll<HTMLButtonElement>("[data-category]")];
  // A distro is scanned, and a language or a company glints.
  const choose = (kind: Kind) => {
    category = kind;
    for (const b of categories) b.setAttribute("aria-pressed", String(b.dataset.category === kind));
    for (const b of motions) b.setAttribute("aria-pressed", String(b.dataset.motion === (kind === "distros" ? "scan" : "glint")));
    update();
  };
  for (const b of categories) b.addEventListener("click", () => choose(b.dataset.category as Kind));
  for (const b of motions) b.addEventListener("click", () => choose(b.dataset.motion === "scan" ? "distros" : category === "distros" ? "companies" : category));

  const label = () => {
    inkButton.firstElementChild!.textContent = mono ? "[colour]" : "[mono]";
    inkButton.setAttribute("aria-label", mono ? "Show the logo in colour" : "Show the logo in one ink");
  };
  label();
  inkButton.addEventListener("click", () => {
    mono = !mono;
    try {
      localStorage.setItem("ascii-ink", mono ? "mono" : "colour");
    } catch {}
    label();
    update();
  });
  // The header's [play anyway] stores its choice; start the logo again under it.
  $("motion")?.addEventListener("click", () => setTimeout(play, 0));

  // --- out --------------------------------------------------------------------

  $("download").addEventListener("click", () => made && save(`${made.slug}.ts`, made.ts, "text/plain;charset=utf-8"));
  $("svg-light").addEventListener("click", () => made && save(`${made.slug}.svg`, svgOf(made.piece, false), "image/svg+xml"));
  $("svg-dark").addEventListener("click", () => made && save(`${made.slug}.dark.svg`, svgOf(made.piece, true), "image/svg+xml"));
  $("download-gif").addEventListener("click", async () => {
    if (!made) return;
    const btn = $("download-gif");
    const orig = btn.firstElementChild!.textContent;
    btn.firstElementChild!.textContent = "[encoding…]";
    btn.setAttribute("disabled", "");
    try {
      const look: Look = {
        mono,
        ink: getComputedStyle(document.documentElement).getPropertyValue("--ink").trim() || "#000",
        well: getComputedStyle(document.documentElement).getPropertyValue("--well").trim() || "#fff",
      };
      const seconds = made.piece.meta.loop || 2;
      const blob = await makeGif(made.piece, look, 0, seconds, (part) => {
        btn.firstElementChild!.textContent = `[encoding… ${Math.round(part * 100)}%]`;
      });
      save(`${made.slug}.gif`, blob, "image/gif");
    } catch (err) {
      console.warn("[make] gif download failed:", err);
      say(`gif download failed: ${(err as Error).message}`);
    } finally {
      btn.firstElementChild!.textContent = orig;
      btn.removeAttribute("disabled");
    }
  });
</script>
